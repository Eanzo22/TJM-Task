# Set these in your shell. The CLI does not silently load .env files.
# Ollama /api/chat compatible endpoint. Local processing is the default.
FAKTURAMA_VISION_URL=http://localhost:11434/api/chat
FAKTURAMA_VISION_MODEL=
# Optional Authorization bearer token for a configured private inference service.
FAKTURAMA_VISION_TOKEN=
FAKTURAMA_UI_PROFILE=config/live.json
FAKTURAMA_RUNS=runs
