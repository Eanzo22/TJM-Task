        "operation": "type_text",
        "value": "${input.external_reference}",
        "read": "native_text",
        "commit_path": [
          {
            "control_type": "Pane",
            "title": "New Order"
          },
          {
            "control_type": "Edit",
            "title": "",
            "to_right_of": "No."
          }
        ]
