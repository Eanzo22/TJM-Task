          {
            "control_type": "Pane",
            "title": "New Invoice"
          },
          {
            "control_type": "ComboBox",
            "title": "",
            "to_right_of": {
              "control_type": "CheckBox",
              "title": "paid"
            }
          }
        ],
        "value": "${invoice_payment.payment_method}"
      },
      {
        "operation": "toggle",
        "path": [
          {
            "control_type": "Pane",
            "title": "New Invoice"
          },
          {
            "control_type": "CheckBox",
            "title": "paid"
          }
        ],
        "value": "${invoice_payment.paid}"
      },
      {
        "operation": "set",
        "path": [
          {
            "control_type": "Pane",
            "title": "New Invoice"
          },
          {
            "control_type": "Edit",
            "title": "",
            "to_right_of": "at"
          }
        ],
        "value": "${invoice_payment.payment_date}",
        "format": "date_english",
        "commit_path": [
          {
            "control_type": "Pane",
            "title": "New Invoice"
          },
          {
            "control_type": "Edit",
            "title": "Cust.Ref."
          }
        ],
        "when": "${invoice_payment.paid}"
      },
      {
        "operation": "type_text",
        "path": [
          {
            "control_type": "Pane",
            "title": "New Invoice"
          },
          {
            "control_type": "Edit",
            "title": "Value"
          }
        ],
        "value": "${invoice_payment.value}",
        "read": "native_text",
        "transform": "decimal",
        "decimal_separator": ",",
        "commit_path": [
          {
            "control_type": "Pane",
            "title": "New Invoice"
          },
          {
            "control_type": "Edit",
            "title": "Cust.Ref."
          }
        ],
        "when": "${invoice_payment.paid}"
      }
    ],
    "save_order": [
      {
        "operation": "select_tab",
        "path": [
          {
            "control_type": "Pane",
            "title": "New Order"
          },
          {
            "control_type": "TabItem",
            "title": "Invoice address"
          }
