        "path": [
          {
            "control_type": "Pane",
            "title": "New Order"
          },
          {
            "control_type": "ComboBox",
            "title": ""
          }
        ],
        "operation": "select_option",
        "value": "Net"
      },
      {
        "path": [
          {
            "control_type": "Pane",
            "title": "New Order"
          },
          {
            "control_type": "ComboBox",
            "title": "VAT"
          }
        ],
        "operation": "select_option",
        "value": "With VAT"
      }
    ],
    "fill_order_date": [
      {
        "path": [
          {
            "control_type": "Pane",
            "title": "New Order"
          },
          {
            "control_type": "Edit",
            "title": "",
