        "query": "items_raw",
        "index": "${index}",
        "sku": "${line.sku}",
        "column": "quantity",
        "value": "${line.quantity}",
        "layout": {
          "width": 1450,
          "header_height": 25,
          "row_height": 25,
          "header_sha256": "daa2dbb14055c84c4525add5b654605675142f65e8ff32662be03b323630cd26",
          "columns": {
            "quantity": 112,
            "name": 487,
            "vat": 737,
            "unit_price": 862,
            "discount": 987
          }
        },
        "commit_path": [
          {
            "control_type": "Pane",
            "title": "New Order"
          },
          {
            "control_type": "Edit",
            "title": "Cust.Ref."
          }
        ]
      },
      {
        "operation": "edit_item_cell",
        "query": "items_raw",
        "index": "${index}",
        "sku": "${line.sku}",
